# === Devam branch: full working repo for collaborative paper edits ===
# This branch ignores only OS junk, build artifacts, secrets, and very
# large generated outputs. Everything else (LaTeX, docs, tests, traces,
# scripts, notebooks) is tracked so Claude Code on the other side has
# full context to edit the paper.

# Python / build cache
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
wheels/
.pytest_cache/
.pytest-tmp/
.pytest-tmp*/
.mypy_cache/
.ruff_cache/

# Virtual environments and editor / agent local state
.venv/
.env
.env.*
.vscode/
.idea/
.claude/
.DS_Store

# LaTeX build output (regenerated by pdflatex)
research/*.aux
research/*.bbl
research/*.blg
research/*.log
research/*.out
research/*.fls
research/*.fdb_latexmk
research/*.synctex.gz
research/*.dvi
research/build_*.txt
research/pdflatex*.fls

# Local backups / extraction scratch under research/
research/_backups/
research/_formatting_extracted/
research_frozen_*/

# Local archives and ad-hoc scratch
archive/
tmp/
replay/
docs/*.pdf
LLM_*.md
llm_call_*.md
_llm_call*.json
/RESULTS.md
/*.txt
